---
import type { DebutApp } from "../data/apps";
import DateSticker from "./DateSticker.astro";
import ScreenCarousel from "./ScreenCarousel.astro";

interface Props {
  app: DebutApp;
}
const { app } = Astro.props;
const debutDate = new Date(app.debutDate + "T00:00:00");
const dateLabel = debutDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
const initialPlatform = app.platform === "android" ? "android" : "ios";
const initialStoreUrl = initialPlatform === "android" ? app.storeUrlAndroid : app.storeUrlIos;
---

<div class="spotlight-stage">
  <DateSticker date={debutDate} />
  <article class="spotlight-shell">
    <div class="visual-col">
      <ScreenCarousel screens={app.screens} appName={app.name} size="md" />
    </div>

    <div class="details-pane">
      <div class="spotlight-label mono">
        <span class="live-dot" aria-hidden="true"></span>
        Today's debut
      </div>

      <div class="app-row">
        <div class="app-heading">
          {app.iconUrl
            ? <img class="app-icon" src={app.iconUrl} alt={`${app.name} mobile app icon`} width="52" height="52" />
            : <div class="app-icon" aria-hidden="true" set:html={app.icon} />}
          <h2 class="app-title">{app.name}</h2>
        </div>
        {app.platform === "both" && (
          <div class="platform-switch" role="group" aria-label="Choose platform">
            <button type="button" class="active" data-platform="ios">iPhone</button>
            <button type="button" data-platform="android">Android</button>
          </div>
        )}
      </div>

      <div class="launch-meta mono">First public release · {dateLabel}</div>

      <p class="app-copy">{app.tagline}</p>

      {app.whyItsHere && (
        <div class="why">
          <strong>Why it's here:</strong> {app.whyItsHere}
        </div>
      )}

      <div class="cta-row">
        <a class="btn btn-red" id="storeButton" href={initialStoreUrl ?? "#"}>
          Get {app.name} for {initialPlatform === "android" ? "Android" : "iPhone"}
        </a>
        <a class="text-link" href={`/${app.slug}`}>Read {app.name}'s debut ›</a>
      </div>
    </div>
  </article>
</div>

<script define:vars={{ name: app.name, ios: app.storeUrlIos, android: app.storeUrlAndroid }}>
  document.querySelectorAll(".platform-switch button").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".platform-switch button").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const storeButton = document.getElementById("storeButton");
      if (!storeButton) return;
      if (btn.dataset.platform === "android") {
        storeButton.textContent = `Get ${name} for Android`;
        storeButton.setAttribute("href", android || "#");
      } else {
        storeButton.textContent = `Get ${name} for iPhone`;
        storeButton.setAttribute("href", ios || "#");
      }
    });
  });
</script>

<style>
  .spotlight-stage { position: relative; }

  .spotlight-shell {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 26px;
    box-shadow: var(--shadow);
    display: grid;
    grid-template-columns: 420px 1fr;
    overflow: hidden;
  }

  .visual-col {
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
  }

  .visual-col :global(.visual-pane) {
    flex: 1;
    padding: 64px 24px 40px;
  }

  .details-pane { padding: 46px 48px; }

  .spotlight-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--red-ink);
    margin-bottom: 18px;
  }
  .spotlight-label .live-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--red);
    animation: pulse 2.2s ease-in-out infinite;
  }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

  .app-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .app-heading { display: flex; align-items: center; gap: 14px; }

  .app-icon {
    width: 52px; height: 52px;
    border-radius: 13px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--display);
    font-weight: 800;
    font-size: 24px;
    display: grid;
    place-items: center;
    flex: none;
    object-fit: cover;
  }

  .app-title {
    font-family: var(--display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -.03em;
    margin: 0;
  }

  .platform-switch {
    display: inline-flex;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 3px;
    background: var(--wash);
  }
  .platform-switch button {
    border: 0;
    background: transparent;
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .platform-switch button.active { background: var(--ink); color: var(--paper); }

  .launch-meta { margin-bottom: 20px; }

  .app-copy {
    margin: 0 0 22px;
    color: var(--ink-soft);
    font-size: 17.5px;
    max-width: 46ch;
  }

  .why {
    border-left: 3px solid var(--red);
    background: var(--red-wash);
    border-radius: 0 12px 12px 0;
    padding: 14px 18px;
    font-size: 15.5px;
    color: var(--ink-soft);
    margin-bottom: 28px;
    max-width: 52ch;
  }
  .why strong { color: var(--ink); }

  .cta-row { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }

  @media (max-width: 880px) {
    .spotlight-shell { grid-template-columns: 1fr; }
    .visual-col { border-right: 0; border-bottom: 1px solid var(--line); }
    .details-pane { padding: 32px 26px 38px; }
    .app-title { font-size: 33px; }
  }
</style>
