---
interface Props {
  date: Date;
}
const { date } = Astro.props;
const weekday = date.toLocaleDateString("en-US", { weekday: "long" });
const day = date.getDate();
const month = date.toLocaleDateString("en-US", { month: "long", year: "numeric" });
---

<div class="leaf" aria-label={`Today: ${weekday}, ${month} ${day}`}>
  <span class="mono leaf-weekday">{weekday}</span>
  <span class="leaf-num-wrap">
    <span class="leaf-num">{day}</span>
    <svg class="leaf-ring" viewBox="0 0 180 140" aria-hidden="true">
      <ellipse cx="90" cy="70" rx="82" ry="60" transform="rotate(-4 90 70)"></ellipse>
    </svg>
  </span>
  <span class="mono leaf-month">{month}</span>
</div>

<style>
  .leaf {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 13px 26px 9px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 13px;
    box-shadow: 0 12px 26px rgba(27, 28, 31, .16);
    position: absolute;
    top: -22px;
    left: -14px;
    z-index: 5;
    transform: rotate(-8deg) scale(.78);
    transform-origin: top left;
    animation: sticker-drop .55s .15s cubic-bezier(.2, .9, .3, 1.05) both;
  }

  .leaf::before {
    content: "";
    position: absolute;
    top: 6px; left: 50%;
    transform: translateX(-50%);
    width: 44px; height: 4px;
    background:
      radial-gradient(circle 2px at 4px 50%, var(--line-strong) 99%, transparent),
      radial-gradient(circle 2px at 22px 50%, var(--line-strong) 99%, transparent),
      radial-gradient(circle 2px at 40px 50%, var(--line-strong) 99%, transparent);
  }

  .leaf-weekday { margin-top: 5px; color: var(--red-ink); font-size: 10px; letter-spacing: .16em; }

  .leaf-num-wrap { position: relative; display: inline-block; line-height: 1; }

  .leaf-num {
    font-family: var(--display);
    font-weight: 800;
    font-size: 46px;
    letter-spacing: -.04em;
    line-height: 1.05;
    display: block;
  }

  .leaf-ring { position: absolute; inset: -5px -12px -2px; pointer-events: none; }
  .leaf-ring ellipse {
    fill: none;
    stroke: var(--red);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 560;
    stroke-dashoffset: 560;
    animation: ring-draw .7s .45s ease-out forwards;
  }
  @keyframes ring-draw { to { stroke-dashoffset: 40; } }

  .leaf-month { color: var(--muted); font-size: 10px; letter-spacing: .16em; }

  @keyframes sticker-drop {
    from { opacity: 0; transform: rotate(-8deg) translateY(-10px) scale(.82); }
    to { opacity: 1; transform: rotate(-8deg) scale(.78); }
  }

  @media (max-width: 880px) {
    .leaf { top: -18px; left: 14px; transform: rotate(-8deg) scale(.66); }
  }

  @media (prefers-reduced-motion: reduce) {
    .leaf { animation: none; }
    .leaf-ring ellipse { animation: none; stroke-dashoffset: 40; }
  }
</style>
