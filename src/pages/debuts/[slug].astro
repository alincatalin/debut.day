---
import Layout from "../../layouts/Layout.astro";
import ScreenCarousel from "../../components/ScreenCarousel.astro";
import { getAppBySlug } from "../../lib/db";

const { slug } = Astro.params;
const app = slug ? await getAppBySlug(slug) : null;

if (!app) {
  return Astro.redirect("/404");
}

const debutDate = new Date(app.debutDate + "T00:00:00");
const dateLabel = debutDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<Layout
  title={`${app.name} — Debut Day, ${dateLabel}`}
  description={`${app.name}'s debut day on Debut Day: ${app.tagline} First public release, ${dateLabel}.`}
  canonicalPath={`/debuts/${app.slug}`}
>
  <section class="app-header">
    <div class="wrap">
      <div class="header-top">
        <div class="debut-tag mono">
          <span class="live-dot" aria-hidden="true"></span>
          Today's debut
        </div>
        <div class="platform-switch" role="group" aria-label="Choose platform">
          <button type="button" class="active" data-platform="ios">iPhone</button>
          <button type="button" data-platform="android">Android</button>
        </div>
      </div>

      <div class="app-identity">
        <div class="app-icon-lg" aria-hidden="true" set:html={app.icon} />
        <div>
          <h1 class="app-name">{app.name}</h1>
          <p class="app-tagline">{app.tagline}</p>
        </div>
      </div>

      <div class="launch-meta mono">First public release · {dateLabel} · debut.day/{app.slug}</div>

      <div class="cta-row">
        <a class="btn btn-red" id="storeButton" href={app.storeUrlIos ?? "#"}>
          Get {app.name} for iPhone
        </a>
        <a class="btn btn-ghost" href="/#archive">See other debuts</a>
      </div>
    </div>
  </section>

  <section class="carousel-block">
    <div class="wrap">
      <ScreenCarousel screens={app.screens} size="lg" showCaption />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>About {app.name}</h2>
      {app.description.map((para) => <p>{para}</p>)}

      <div class="why">
        <strong>Why it's here:</strong> {app.whyItsHere}
      </div>
    </div>
  </section>

  {app.maker && (
    <section class="section">
      <div class="wrap">
        <h2>A few questions for the maker</h2>
        <div class="interview">
          <div class="interview-head">
            <div class="interview-avatar" aria-hidden="true">{app.maker.name.charAt(0)}</div>
            <div>
              <div class="interview-who">{app.maker.name}</div>
              <div class="interview-role">{app.maker.role}</div>
            </div>
          </div>

          {app.maker.interview.map((qa) => (
            <div class="qa">
              <p class="qa-q">{qa.q}</p>
              <p class="qa-a">{qa.a}</p>
            </div>
          ))}

          <div class="interview-note">
            Interviews are optional and run when a maker has time to answer a
            few questions before their debut day.
          </div>
        </div>
      </div>
    </section>
  )}

  <div class="wrap">
    <div class="page-footer-nav">
      <a class="text-link" href="/#archive">‹ Browse the archive</a>
      <a class="text-link" href="/submit">Launching soon? Claim your day ›</a>
    </div>
  </div>
</Layout>

<script define:vars={{ name: app.name, ios: app.storeUrlIos, android: app.storeUrlAndroid }}>
  document.querySelectorAll(".platform-switch button").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".platform-switch button").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const storeButton = document.getElementById("storeButton");
      if (!storeButton) return;
      if (btn.dataset.platform === "android") {
        storeButton.textContent = `Get ${name} for Android`;
        storeButton.setAttribute("href", android || "#");
      } else {
        storeButton.textContent = `Get ${name} for iPhone`;
        storeButton.setAttribute("href", ios || "#");
      }
    });
  });
</script>

<style>
  .app-header { padding: 48px 0 8px; }

  .header-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  .debut-tag { display: inline-flex; align-items: center; gap: 8px; color: var(--red-ink); }
  .debut-tag .live-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--red);
    animation: pulse 2.2s ease-in-out infinite;
  }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

  .platform-switch {
    display: inline-flex;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 3px;
    background: var(--wash);
    flex: none;
  }
  .platform-switch button {
    border: 0; background: transparent; border-radius: 999px;
    padding: 7px 15px; font-size: 13px; font-weight: 600; color: var(--muted);
  }
  .platform-switch button.active { background: var(--ink); color: var(--paper); }

  .app-identity { display: flex; align-items: center; gap: 18px; margin-bottom: 16px; }

  .app-icon-lg {
    width: 76px; height: 76px;
    border-radius: 19px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--display);
    font-weight: 800;
    font-size: 34px;
    display: grid;
    place-items: center;
    flex: none;
    box-shadow: var(--shadow-soft);
  }

  .app-name {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(34px, 5.6vw, 48px);
    letter-spacing: -.03em;
    line-height: 1.02;
    margin: 0 0 6px;
  }
  .app-tagline { color: var(--ink-soft); font-size: 17px; margin: 0; }

  .launch-meta { margin: 0 0 26px; }
  .cta-row { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-bottom: 44px; }

  .carousel-block { margin-bottom: 56px; }
  .carousel-block .wrap :global(.visual-pane) {
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 54px 30px;
  }

  .section { padding: 0 0 56px; max-width: 860px; margin-inline: auto; }
  .section h2 {
    font-family: var(--display);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -.02em;
    margin: 0 0 16px;
  }
  .section p { color: var(--ink-soft); margin: 0 0 14px; max-width: 68ch; }
  .section p:last-child { margin-bottom: 0; }

  .why {
    border-left: 3px solid var(--red);
    background: var(--red-wash);
    border-radius: 0 12px 12px 0;
    padding: 16px 20px;
    font-size: 15.5px;
    color: var(--ink-soft);
    margin-top: 20px;
    max-width: 60ch;
  }
  .why strong { color: var(--ink); }

  .interview {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 38px 40px;
    box-shadow: var(--shadow-soft);
  }
  .interview-head { display: flex; align-items: center; gap: 14px; margin-bottom: 26px; }
  .interview-avatar {
    width: 46px; height: 46px;
    border-radius: 50%;
    background: var(--wash);
    border: 1px solid var(--line-strong);
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
    color: var(--ink-soft);
    flex: none;
  }
  .interview-who { font-weight: 600; font-size: 15.5px; }
  .interview-role { font-size: 13.5px; color: var(--muted); }
  .qa { margin-bottom: 24px; }
  .qa:last-child { margin-bottom: 0; }
  .qa-q {
    font-family: var(--display);
    font-weight: 700;
    font-size: 16.5px;
    letter-spacing: -.01em;
    margin: 0 0 8px;
    color: var(--red-ink);
  }
  .qa-a { margin: 0; color: var(--ink-soft); max-width: 66ch; }
  .interview-note {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }

  .page-footer-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 44px 0;
    border-top: 1px solid var(--line);
    margin-top: 20px;
  }

  @media (max-width: 640px) {
    .app-identity { gap: 14px; }
    .app-icon-lg { width: 60px; height: 60px; border-radius: 15px; font-size: 26px; }
    .interview { padding: 28px 24px; }
    .header-top { flex-direction: column; }
  }
</style>
